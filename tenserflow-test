import csv
import os
import re
import sys
from collections import defaultdict
from datetime import datetime
from pathlib import Path

import pyodbc

DOSSIER = r"D:\Projets\KPI_Acces_Theia\resultats"
SERVEUR = r"swucfrbikpa9667.dom101.intres,30295"
BASE = "KPI_PAG"
UTILISATEUR = "A_RENSEIGNER"
MOT_DE_PASSE = os.getenv("KPI_PAG_MDP", "")  # à définir dans le job, pas dans le script
PILOTE = "ODBC Driver 17 for SQL Server"

JOURNALIERS = {"KME-07"}  # CSV par jour, on met le total du mois en base
CLE = "Ref = ? AND Mois = ? AND Indicateur = ? AND [type] = ?"


def lire(chemin):
    brut = chemin.read_bytes()
    try:
        texte = brut.decode("utf-8-sig")
    except UnicodeDecodeError:
        texte = brut.decode("cp1252")  # le ps1 écrit en UTF-8 ou en ANSI
    return [l for l in csv.reader(texte.splitlines(), delimiter=";") if any(c.strip() for c in l)]


def convertir(ligne):
    ref, mois, indicateur, type_, m = (c.strip() for c in ligne)  # plante si pas 5 colonnes
    if not re.fullmatch(r"K[A-Z]{2}-\w+", ref):  # ref = nom de table, on vérifie
        raise ValueError(f"ref invalide : {ref}")
    return ref, datetime.strptime(mois, "%d/%m/%Y").date(), indicateur, type_, int(m) if m else None


def totaux_mensuels(lignes):
    jours = {}
    for *cle, m in lignes:  # un jour vu dans plusieurs fichiers : on garde sa plus grande valeur
        jours[tuple(cle)] = max(jours.get(tuple(cle), 0), m or 0)
    mois = defaultdict(int)
    for (ref, jour, indicateur, type_), m in jours.items():
        mois[ref, jour.replace(day=1), indicateur, type_] += m
    return [(*cle, m) for cle, m in mois.items()]


def importer(cur, ref, mois, indicateur, type_, m):
    t = f"[dbo].[{ref}]"
    cle = (ref, mois, indicateur, type_)
    if m is not None:
        # mensuel : on remplit seulement un M vide ; journalier : on garde le total le plus grand
        if ref in JOURNALIERS:
            cur.execute(f"UPDATE {t} SET M = ? WHERE {CLE} AND (M IS NULL OR M < ?)", m, *cle, m)
        else:
            cur.execute(f"UPDATE {t} SET M = ? WHERE {CLE} AND M IS NULL", m, *cle)
        if cur.rowcount > 0:
            return "maj"
    cur.execute(f"INSERT INTO {t} (Ref, Mois, Indicateur, [type], M) SELECT ?, ?, ?, ?, ? "
                f"WHERE NOT EXISTS (SELECT 1 FROM {t} WHERE {CLE})", *cle, m, *cle)
    return "inserees" if cur.rowcount > 0 else "doublons"


def main():
    fichiers = sorted(Path(DOSSIER).glob("*.csv"))
    print(f"--- {datetime.now():%d/%m/%Y %H:%M} : {len(fichiers)} fichiers")
    lignes, erreurs = [], 0
    for chemin in fichiers:
        try:
            lignes += [convertir(l) for l in lire(chemin)]
        except Exception as e:
            erreurs += 1
            print(f"erreur fichier {chemin.name} : {e}")

    lignes = ([l for l in lignes if l[0] not in JOURNALIERS]
              + totaux_mensuels([l for l in lignes if l[0] in JOURNALIERS]))
    par_table = {}
    for l in lignes:
        par_table.setdefault(l[0], []).append(l)

    conn = pyodbc.connect(f"DRIVER={{{PILOTE}}};SERVER={SERVEUR};DATABASE={BASE};"
                          f"UID={UTILISATEUR};PWD={MOT_DE_PASSE};Encrypt=yes;TrustServerCertificate=yes;")
    cur = conn.cursor()
    cur.execute("SET NOCOUNT OFF")  # au cas où le serveur l'active : sinon rowcount = -1
    total = {"inserees": 0, "maj": 0, "doublons": 0}
    for table, lignes_table in sorted(par_table.items()):
        compte = dict.fromkeys(total, 0)
        try:
            for l in lignes_table:
                compte[importer(cur, *l)] += 1
            conn.commit()  # une table = une transaction
        except Exception as e:
            conn.rollback()
            erreurs += 1
            print(f"erreur table {table}, rien importé pour cette table : {e}")
            continue
        for k in total:
            total[k] += compte[k]

    conn.close()
    print(f"insérées {total['inserees']} | mises à jour {total['maj']} | "
          f"déjà en base {total['doublons']} | erreurs {erreurs}")
    return 1 if erreurs else 0


if __name__ == "__main__":
    try:
        code = main()
    except Exception as e:  # le .bat ne garde que stdout, donc on affiche l'erreur
        print(f"échec : {e}")
        code = 1
    sys.exit(code)
