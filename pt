import pandas as pd
from sqlalchemy import create_engine, text, inspect
from urllib.parse import quote_plus
import sys

SERVER = "swucfrbis652734.dom101.intres,30295"
DATABASE = "KPI_PAG_09"
USER = "pocBIS65KPIpse"
PASSWORD = "TON_MOT_DE_PASSE"
EXCEL_PATH = "KPI PAG 2026 - Données.xlsx"
ODBC_DRIVER = "ODBC Driver 17 for SQL Server"

CLES_KPI = ["Ref", "Mois", "Indicateur", "type"]


def build_engine():
    conn_str = (
        "DRIVER={" + ODBC_DRIVER + "};"
        f"SERVER={SERVER};"
        f"DATABASE={DATABASE};"
        f"UID={USER};"
        f"PWD={PASSWORD};"
        "Encrypt=yes;"
        "TrustServerCertificate=yes;"
    )
    url = f"mssql+pyodbc:///?odbc_connect={quote_plus(conn_str)}"
    return create_engine(url, fast_executemany=True)


def choisir_cles(colonnes):
    for identifiant in ("Numéro", "Incident", "Identifiant Groupe"):
        if identifiant in colonnes:
            return [identifiant]
    if "Mois" in colonnes:
        return [c for c in CLES_KPI if c in colonnes]
    return list(colonnes)


def normaliser(df, cles):
    out = pd.DataFrame(index=df.index)
    for c in cles:
        s = df[c]
        if c == "Mois":
            out[c] = pd.to_datetime(s, errors="coerce").dt.strftime("%Y-%m-%d")
        elif pd.api.types.is_datetime64_any_dtype(s):
            out[c] = s.dt.strftime("%Y-%m-%d %H:%M:%S")
        elif pd.api.types.is_numeric_dtype(s):
            out[c] = pd.to_numeric(s).map(lambda x: "" if pd.isna(x) else f"{x:g}")
        else:
            out[c] = s.where(s.notna(), "").astype(str).str.strip()
    return out.fillna("").agg("|".join, axis=1)


def main():
    print(f"Lecture : {EXCEL_PATH}")
    try:
        sheets = pd.read_excel(EXCEL_PATH, sheet_name=None, engine="openpyxl")
    except FileNotFoundError:
        print("Fichier introuvable")
        sys.exit(1)

    try:
        engine = build_engine()
        with engine.connect() as conn:
            conn.execute(text("SELECT 1"))
    except Exception as e:
        print(f"Erreur connexion : {e}")
        sys.exit(1)

    insp = inspect(engine)

    for sheet_name, df in sheets.items():
        table = sheet_name.strip()
        df.columns = [str(c).strip() for c in df.columns]
        df = df.dropna(how="all")
        if df.empty:
            continue

        try:
            if not insp.has_table(table, schema="dbo"):
                df.to_sql(table, engine, schema="dbo", if_exists="append",
                          index=False, chunksize=1000)
                print(f"[{table}] table créée : {len(df)} lignes")
                continue

            cols_sql = [c["name"] for c in insp.get_columns(table, schema="dbo")]
            df = df[[c for c in df.columns if c in cols_sql]]

            cles = choisir_cles(df.columns)
            select = ", ".join(f"[{c}]" for c in cles)
            existant = pd.read_sql(f"SELECT {select} FROM [dbo].[{table}]", engine)

            deja = set(normaliser(existant, cles))
            nouveau = df[~normaliser(df, cles).isin(deja)].drop_duplicates()

            if nouveau.empty:
                print(f"[{table}] rien de nouveau")
                continue

            nouveau.to_sql(table, engine, schema="dbo", if_exists="append",
                           index=False, chunksize=1000)
            print(f"[{table}] {len(nouveau)} nouvelles lignes ajoutées")
        except Exception as e:
            print(f"[{table}] ERREUR : {e}")


if __name__ == "__main__":
    main()
